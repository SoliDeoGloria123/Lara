# ============================================
# {{ project_name }} - Configuración
# ============================================

PROJECT_NAME={{ project_name }}

# ============================================
# BASE DE DATOS
# ============================================

# Tipo de base de datos: sqlite, postgresql, mysql, mssql, mongodb
DATABASE_TYPE=sqlite

# ──────────────────────────────────────────
# SQL - Elige UNA de estas opciones:
# ──────────────────────────────────────────

# SQLite (local, desarrollo)
DATABASE_URL=sqlite:///./app.db

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MySQL / MariaDB
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/dbname

# SQL Server (formato SQLAlchemy)
# DATABASE_URL=mssql+pyodbc://sa:password@localhost\SQLEXPRESS/master?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# SQL Server (formato SSMS - Lara lo convierte automáticamente)
# DATABASE_URL=Data Source=localhost\SQLEXPRESS;Initial Catalog=master;User ID=sa;Password=your_password;Trust Server Certificate=True

# ──────────────────────────────────────────
# MongoDB
# ──────────────────────────────────────────

# MongoDB Atlas (recomendado para producción)
# DATABASE_TYPE=mongodb
# MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/database_name?retryWrites=true&w=majority&tlsAllowInvalidCertificates=true

# MongoDB Compass (local)
# DATABASE_TYPE=mongodb
# MONGODB_URL=mongodb://localhost:27017/database_name

# ============================================
# SEGURIDAD - JWT
# ============================================

# Genera una clave secreta segura con: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS - Orígenes permitidos
# ============================================

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
